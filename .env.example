# Unsnow Mail 邮箱服务
EMAIL_API_KEY=um_your_key_here
EMAIL_API_BASE=https://mail.unsnow.org

# HeroSMS 接码平台
SMS_TOKEN=your_sms_token_here
SMS_API_BASE=https://sms.fudugeek.xyz

# 浏览器配置
HEADLESS=false
CHROME_USER_DATA_DIR=
SCREENSHOT_DIR=./screenshots

# 超时配置 (毫秒)
EMAIL_POLL_TIMEOUT=120000
SMS_POLL_TIMEOUT=120000
PAGE_TIMEOUT=30000

# DNS 污染修复覆盖 (可选,格式 host:ip,host:ip;默认映射内置在 src/utils/dns-fix.ts)
# DNS_OVERRIDES=sms.fudugeek.xyz:1.2.3.4,mail.unsnow.org:5.6.7.8

# 代理 (可选;http://user:pass@host:port;启用后浏览器走代理出口,避免同 IP 批量触发风控;
# 代理域名被 DNS 污染时会自动 DoH 解析真实 IP;凭证无效会在启动时预检报错)
# PROXY_URL=http://user:pass@gate.ipfoxy.io:58688

# Web 控制台端口 (可选,默认 5174)
# WEB_PORT=5174
